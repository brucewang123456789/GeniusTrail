# === HuggingFace / Search tokens (KEEP YOUR REAL VALUES; DO NOT COMMIT) ===
HF_TOKEN=
HF_HUB_TOKEN=
SERPER_API_KEY=

# === LLM / vLLM endpoint ===
CITEVIZOR_LLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_ENDPOINT=http://127.0.0.1:8000/v1
OPENAI_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-AWQ
OPENAI_API_KEY=local-123
VLLM_TIMEOUT_S=60
VLLM_MAX_TOKENS=1024
VLLM_TEMPERATURE=0.2
VLLM_TOP_P=0.9

# === Client-side safeguards to avoid guided-decoding ===
# Disable any JSON-schema / grammar hard enforcement from client
SUMMARIZER_JSON_STRICT=0
# Hard switch used by our client to avoid sending response_format/grammar hints
CITEVIZOR_DISABLE_GUIDED=1

# === PDF / figure extraction ===
PDFFIGURES2_JAR=/workspace/tools/pdffigures2/target/scala-2.12/pdffigures2-assembly-0.1.0.jar
PDFFIGURES2_TIMEOUT_S=120
FITZ_DPI=260
MAX_FIGURES_PER_PDF=256
OCR_LANGS=eng,chi_sim

# === Downloader behavior ===
USER_AGENT=CiteVizor/0.2 (+pdf-first)
ACCEPT_LANGUAGE=en-US,en;q=0.9
MAX_DOWNLOAD_MB=120
HTTPS_PROXY=
HTTP_PROXY=
UNPAYWALL_EMAIL=

# === Ranking / re-ranking ===
RERANKER_ENABLED=1
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RECENCY_HALFLIFE_YEARS=4.0
TYPE_BOOST_FIGURE=0.15
TYPE_BOOST_TABLE=0.10

# === Metadata enrichment ===
ENRICH_CROSSREF_ENABLED=1
ENRICH_OPENALEX_ENABLED=1
ENRICH_SEMSCHOLAR_ENABLED=0
ENRICH_TIMEOUT_S=8
ENRICH_BACKOFF_BASE=0.6
CROSSREF_MAILTO=

# === Runtime / logging ===
LOG_LEVEL=INFO
# Force headless Matplotlib to avoid display backends
MPLBACKEND=Agg
# Ensure our package imports prefer workspace
PYTHONPATH=/workspace
